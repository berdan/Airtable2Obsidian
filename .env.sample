# Copy this file to .env and fill in your own values.

# Your Airtable personal access token (PAT).
# Create one at https://airtable.com/create/tokens with the scopes:
#   - schema.bases:read   (list bases and read table/field schema)
#   - data.records:read   (read record data)
# Grant it access to the bases you want to export.
AIRTABLE_PAT=your_personal_access_token_here

# Optional: where the Markdown is written (default: ./export)
# A2O_OUTPUT_DIR=export

# Optional: where attachments (images, files) are downloaded to. Airtable's
# attachment URLs expire after a few hours, so every attachment is saved here and
# referenced from notes as a [[filename.ext]] embed. Must be inside the output
# directory. Files that already exist are reused, so re-runs are cheap.
# (default: <A2O_OUTPUT_DIR>/_attachments)
# A2O_ATTACHMENTS_DIR=export/_attachments

# Optional: what goes in the note body below the frontmatter (default: none)
#   none    frontmatter only (edit properties in Obsidian, nothing goes stale)
#   fields  every field repeated as "## Field" + value (the old behaviour)
#   <name>  the name of a long-text field to use as the body; that field is then
#           left out of the frontmatter. Tables without it get an empty body.
# A2O_BODY=none

# Optional: strip emoji from property and folder names, e.g. "Pennor ✒️" -> "Pennor"
# (default: false)
# A2O_STRIP_EMOJI=false
