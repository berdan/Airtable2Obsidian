# Copy this file to .env and fill in your own values.

# Your Airtable personal access token (PAT).
# Create one at https://airtable.com/create/tokens with the scopes:
#   - schema.bases:read   (list bases and read table/field schema)
#   - data.records:read   (read record data)
# Grant it access to the bases you want to export.
AIRTABLE_PAT=your_personal_access_token_here

# Optional: where the Markdown is written (default: ./export)
# A2O_OUTPUT_DIR=export
