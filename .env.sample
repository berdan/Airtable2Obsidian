# Copy this file to .env and fill in your own values.
# These can be found in your Airtable API documentation:
# https://airtable.com/developers/web/api/introduction

# Your Airtable personal access token / API key
AIRTABLE_API_KEY=api_key_here

# The ID of the Airtable base you want to export
AIRTABLE_BASE_ID=airtable_base_id_here

# Comma-separated list of table names to export, e.g. Table1,Table2,Table3
AIRTABLE_TABLE_NAMES=table1,table2
